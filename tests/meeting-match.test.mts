import assert from 'node:assert/strict';
import { isSameAsMeeting, matchingMeeting } from '../src/meeting-match.ts';
const same = (a: string, b: string) => assert.ok(isSameAsMeeting(a, b), `${a} = ${b}`);
const diff = (a: string, b: string) => assert.ok(!isSameAsMeeting(a, b), `${a} != ${b}`);
same('1:1 with Alex', '1:1 with Alex');
same('1 on 1 with Alex', '1:1 with Alex');
same('one-on-one Alex', '1:1 with Alex');
same('standup', 'Team standup');
same('customer call', 'Customer call');
same('Design review', 'Design review');
same('Sprint planning meeting', 'Sprint planning');
diff('prep for design review', 'Design review');
diff("prep slides for Thursday's demo", 'Demo');
diff('send notes from customer call', 'Customer call');
diff('review Sam\'s pull request', 'Design review');
diff('book flights to Berlin', 'Berlin offsite');
diff('call', 'Customer call');
diff('', 'Team standup');
diff('1:1 with Sam', '1:1 with Alex');
assert.equal(matchingMeeting('1:1 with Alex', [{ title: 'Team standup' }, { title: '1:1 with Alex' }])?.title, '1:1 with Alex');
assert.equal(matchingMeeting('Finish the roadmap', [{ title: 'Team standup' }]), undefined);
console.log('meeting match: all assertions passed');
